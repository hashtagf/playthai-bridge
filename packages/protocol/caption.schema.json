{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thai caption v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "text",
    "language",
    "duration_ms",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "text": {
      "type": "string",
      "maxLength": 500,
      "description": "Plain text. Empty hides. Receiver additionally limits to 500 UTF-16 code units; no control characters except newline."
    },
    "language": {
      "const": "th"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 250,
      "maximum": 15000
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Metadata only. Never used for expiry."
    }
  }
}
